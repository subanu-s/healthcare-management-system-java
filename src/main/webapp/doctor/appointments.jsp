<%@page import="com.entity.*,com.dao.*,com.db.DbConnect,java.util.*"%><%Doctor d=(Doctor)session.getAttribute("doctorObj");if(d==null){response.sendRedirect("../doctor_login.jsp");return;}List<Appointment>a;try(java.sql.Connection c=DbConnect.getConn()){a=new AppointmentDao(c).byDoctor(d.getId());}%><html><head><%@include file="../component/allcss.jsp"%></head><body><div class="container py-4"><a href="dashboard.jsp">&larr; Dashboard</a><h2>Appointments</h2><table class="table table-bordered"><tr><th>Patient</th><th>Date</th><th>Reason</th><th>Status</th><th>Action</th></tr><%for(Appointment x:a){%><tr><td><%=x.patientName%></td><td><%=x.appointmentDate%></td><td><%=x.disease%></td><td><%=x.status%></td><td><form method="post" action="update-appointment"><input type="hidden" name="appointmentId" value="<%=x.id%>"><select name="status"><option>CONFIRMED</option><option>COMPLETED</option><option>CANCELLED</option></select><button>Update</button></form></td></tr><%}%></table></div></body></html>