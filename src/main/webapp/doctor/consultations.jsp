<%@page import="com.entity.*,com.dao.*,com.db.DbConnect,java.util.*"%><%Doctor d=(Doctor)session.getAttribute("doctorObj");if(d==null){response.sendRedirect("../doctor_login.jsp");return;}List<Consultation>a;try(java.sql.Connection c=DbConnect.getConn()){a=new ConsultationDao(c).byDoctor(d.getId());}%><html><head><%@include file="../component/allcss.jsp"%></head><body><div class="container py-4"><a href="dashboard.jsp">&larr; Dashboard</a><h2>Online Consultations</h2><%for(Consultation x:a){%><div class="card p-4 mb-3"><b><%=x.requestedDate%> | <%=x.mode%></b><p><%=x.reason%></p><form method="post" action="save-consultation"><input type="hidden" name="consultationId" value="<%=x.id%>"><select class="form-select mb-2" name="status"><option>ACCEPTED</option><option>COMPLETED</option><option>DECLINED</option></select><input class="form-control mb-2" name="meetingLink" placeholder="Meeting link" value="<%=x.meetingLink==null?"":x.meetingLink%>"><textarea class="form-control mb-2" name="doctorNotes" placeholder="Doctor notes"><%=x.doctorNotes==null?"":x.doctorNotes%></textarea><textarea class="form-control mb-2" name="prescription" placeholder="Prescription"><%=x.prescription==null?"":x.prescription%></textarea><button class="btn btn-brand">Save</button></form></div><%}%></div></body></html>