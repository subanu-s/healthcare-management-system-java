<%@page contentType="text/html;charset=UTF-8"%><html><head><title>Create Patient Account</title><%@include file="component/allcss.jsp"%></head><body><%@include file="component/navbar.jsp"%><div class="container py-5"><div class="row justify-content-center"><div class="col-md-5"><div class="card p-4"><h3>Create Patient Account</h3><form method="post" action="user-register"><div class="mb-3"><label>Full Name</label><input class="form-control" name="fullName" required></div><div class="mb-3"><label>Email</label><input class="form-control" type="email" name="email" required></div><div class="mb-3"><label>Password</label><input class="form-control" type="password" name="password" required></div><button class="btn btn-brand w-100">Create Patient Account</button></form></div></div></div></div></body></html>