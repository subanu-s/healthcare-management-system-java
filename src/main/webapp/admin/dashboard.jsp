<%@page import="com.db.DbConnect,java.sql.*"%><%if(session.getAttribute("adminEmail")==null){response.sendRedirect("../admin_login.jsp");return;}int d=0,u=0,a=0,cx=0;try(Connection c=DbConnect.getConn();Statement s=c.createStatement()){ResultSet r=s.executeQuery("SELECT COUNT(*) FROM doctors");if(r.next())d=r.getInt(1);r=s.executeQuery("SELECT COUNT(*) FROM users");if(r.next())u=r.getInt(1);r=s.executeQuery("SELECT COUNT(*) FROM appointments");if(r.next())a=r.getInt(1);r=s.executeQuery("SELECT COUNT(*) FROM consultations");if(r.next())cx=r.getInt(1);}%><html><head><%@include file="../component/allcss.jsp"%></head><body><div class="container py-5"><h2>Admin Dashboard</h2><div class="row g-3"><%String[]n={"Doctors","Patients","Appointments","Consultations"};int[]v={d,u,a,cx};for(int i=0;i<4;i++){%><div class="col-md-3"><div class="card p-4 text-center"><h3><%=v[i]%></h3><%=n[i]%></div></div><%}%></div><a class="btn btn-brand mt-4" href="add_doctor.jsp">Add Doctor</a><a class="btn btn-outline-dark mt-4" href="../logout">Logout</a></div></body></html>