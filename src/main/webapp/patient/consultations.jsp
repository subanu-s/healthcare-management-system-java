<%@page import="com.entity.*,com.dao.*,com.db.DbConnect,java.util.*"%><%User u=(User)session.getAttribute("userObj");if(u==null){response.sendRedirect("../user_login.jsp");return;}List<Doctor>d;List<Consultation>a;try(java.sql.Connection c=DbConnect.getConn()){d=new DoctorDao(c).all();a=new ConsultationDao(c).byUser(u.getId());}%><html><head><%@include file="../component/allcss.jsp"%></head><body><div class="container py-4"><a href="dashboard.jsp">&larr; Dashboard</a><h2>Online Consultation</h2><div class="card p-4"><form method="post" action="../request-consultation" class="row g-3"><select class="form-select" name="doctorId"><%for(Doctor x:d){%><option value="<%=x.getId()%>"><%=x.getFullName()%> - <%=x.getSpecialist()%></option><%}%></select><input class="form-control" type="datetime-local" name="requestedDate" required><select class="form-select" name="mode"><option>Video</option><option>Audio</option><option>Chat</option></select><textarea class="form-control" name="reason" placeholder="Consultation reason" required></textarea><button class="btn btn-brand">Request</button></form></div><h3 class="mt-4">History</h3><table class="table table-bordered"><tr><th>Date</th><th>Mode</th><th>Status</th><th>Meeting</th><th>Notes</th><th>Prescription</th></tr><%for(Consultation x:a){%><tr><td><%=x.requestedDate%></td><td><%=x.mode%></td><td><%=x.status%></td><td><%if(x.meetingLink!=null&&!x.meetingLink.isEmpty()){%><a target="_blank" href="<%=x.meetingLink%>">Join</a><%}else{%>-<%}%></td><td><%=x.doctorNotes==null?"-":x.doctorNotes%></td><td><%=x.prescription==null?"-":x.prescription%></td></tr><%}%></table></div></body></html>