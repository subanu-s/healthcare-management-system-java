<%@page import="com.entity.*,com.dao.*,com.db.DbConnect,java.util.*"%><%User u=(User)session.getAttribute("userObj");if(u==null){response.sendRedirect("../user_login.jsp");return;}List<Doctor>d;List<Appointment>a;try(java.sql.Connection c=DbConnect.getConn()){d=new DoctorDao(c).all();a=new AppointmentDao(c).byUser(u.getId());}%><html><head><%@include file="../component/allcss.jsp"%></head><body><div class="container py-4"><a href="dashboard.jsp">&larr; Dashboard</a><h2>Book Appointment</h2><div class="card p-4"><form method="post" action="../book-appointment" class="row g-3"><input class="form-control" name="patientName" value="<%=u.getFullName()%>" required><select class="form-select" name="gender"><option>Female</option><option>Male</option><option>Other</option></select><input class="form-control" type="number" name="age" placeholder="Age" required><select class="form-select" name="doctorId"><%for(Doctor x:d){%><option value="<%=x.getId()%>"><%=x.getFullName()%> - <%=x.getSpecialist()%></option><%}%></select><input class="form-control" type="date" name="appointmentDate" required><input class="form-control" type="email" name="email" value="<%=u.getEmail()%>" required><input class="form-control" name="phone" placeholder="Phone" required><input class="form-control" name="disease" placeholder="Reason / Disease" required><textarea class="form-control" name="address" placeholder="Address" required></textarea><button class="btn btn-brand">Book</button></form></div><h3 class="mt-4">Your Appointments</h3><table class="table table-bordered"><tr><th>Date</th><th>Reason</th><th>Status</th></tr><%for(Appointment x:a){%><tr><td><%=x.appointmentDate%></td><td><%=x.disease%></td><td><%=x.status%></td></tr><%}%></table></div></body></html>